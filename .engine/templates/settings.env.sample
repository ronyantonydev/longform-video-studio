# Your private settings. Lives in .engine/settings/settings.env and is never committed or shared.
# Paste keys after the = sign, no spaces or quotes. Never paste keys into the chat.

BUDGET_CAP_USD=15

# Images: Google Gemini, used only when no real footage or photo fits.
IMAGE_PROVIDER=gemini
GOOGLE_AI_STUDIO_API_KEY=

# Voice: kokoro (free, runs on this computer). google uses the key above.
# Paid option: elevenlabs | openai
VOICE_PROVIDER=kokoro

# Optional, free: sound effects
FREESOUND_API_KEY=

# Optional, PAID. Leave empty to keep everything free. A channel only uses these if its
# channel-rules.md allows paid tools, and every paid call is checked against the budget first.
HIGGSFIELD_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
